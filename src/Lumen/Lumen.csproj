<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Lumen</Product>
    <Description>Moderne mediaspeler op basis van de VLC-engine</Description>
    <ApplicationIcon>Assets/lumen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Alleen de 64-bit VLC-bibliotheken meenemen op Windows. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="LibVLCSharp" Version="3.*" />
  </ItemGroup>

  <!-- Op Windows wordt de VLC-engine meegeleverd; op Linux gebruikt Lumen de systeem-libvlc. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.*" />
  </ItemGroup>

</Project>
