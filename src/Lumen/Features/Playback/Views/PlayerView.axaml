<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Lumen.Features.Playback.Views"
             x:Class="Lumen.Features.Playback.Views.PlayerView"
             Background="{DynamicResource VideoBackgroundBrush}">

  <views:VideoSurface x:Name="Video"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

</UserControl>
