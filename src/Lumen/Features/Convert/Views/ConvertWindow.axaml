<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:convert="using:Lumen.Features.Convert"
        x:Class="Lumen.Features.Convert.Views.ConvertWindow"
        x:DataType="convert:ConvertViewModel"
        Title="Converteren — Lumen"
        Icon="avares://Lumen/Assets/lumen.ico"
        Width="680" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24">

    <!-- Instellingen -->
    <StackPanel Spacing="14">
      <TextBlock Text="Converteren" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Zet video of muziek om naar een ander formaat. Kies eerst het formaat, voeg dan bestanden toe (of sleep ze hierheen). Ze worden één voor één omgezet." />

      <StackPanel Classes="setting">
        <TextBlock Text="Formaat" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <StackPanel Classes="setting">
        <TextBlock Text="Opslaan in" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding OutputFolderText}" />
          <Button Grid.Column="1" Classes="subtle compact" Margin="8,0,0,0" Content="Kiezen…" Command="{Binding ChooseFolderCommand}" />
          <Button Grid.Column="2" Classes="icon small" Margin="4,0,0,0" Command="{Binding ResetFolderCommand}" ToolTip.Tip="Zelfde map als het origineel">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,18,0,12">
      <Button Classes="accent" Command="{Binding AddFilesCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconPlus}" />
          <TextBlock Text="Bestanden toevoegen en starten" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Content="Afgewerkte wissen" Command="{Binding ClearFinishedCommand}" />
    </StackPanel>

    <!-- Wachtrij -->
    <Border Grid.Row="2" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Jobs}" Margin="12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="convert:ConversionJobViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="4,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="secondary" FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Status}" />
                    <Run Text=" · " />
                    <Run Text="{Binding DestinationName}" />
                  </TextBlock>
                  <ProgressBar Classes="thin" CornerRadius="2" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button Classes="subtle compact" Content="Annuleren" Command="{Binding CancelCommand}" IsVisible="{Binding !IsFinished}" />
                  <Button Classes="subtle compact" Content="Map openen" Command="{Binding ShowInFolderCommand}" IsVisible="{Binding IsFinished}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>

</Window>
