<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Lumen.Features.Shell"
             x:Class="Lumen.Features.Shell.Views.ControlBar"
             x:DataType="shell:MainViewModel">

  <!-- Deze balk ligt altijd over de video: daarom wit op een donker verloop, ongeacht het thema. -->
  <UserControl.Styles>
    <Style Selector=":is(UserControl)">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=":is(UserControl).faded">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.time">
      <Setter Property="Foreground" Value="#D9FFFFFF" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.icon.active">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <Border Padding="20,48,16,14">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#99000000" />
        <GradientStop Offset="1" Color="#E6000000" />
      </LinearGradientBrush>
    </Border.Background>
    <StackPanel Spacing="2">

      <!-- Tijdlijn -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Classes="time" MinWidth="54" Text="{Binding Player.PositionText}" />
        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0"
                Minimum="0"
                Maximum="{Binding Player.DurationSeconds}"
                Value="{Binding Player.PositionSeconds}" />
        <TextBlock Grid.Column="2" Classes="time" MinWidth="54" TextAlignment="Right"
                   Text="{Binding Player.DurationText}" />
      </Grid>

      <!-- Knoppen -->
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="icon" Command="{Binding PreviousCommand}" ToolTip.Tip="Vorige (P)">
            <PathIcon Data="{StaticResource IconPrevious}" />
          </Button>
          <Button Classes="icon" Command="{Binding Player.SkipBackwardCommand}" ToolTip.Tip="10 seconden terug (←)">
            <PathIcon Data="{StaticResource IconRewind}" />
          </Button>
          <Button Classes="play" Margin="4,0" Command="{Binding Player.TogglePlayPauseCommand}" ToolTip.Tip="Afspelen / pauzeren (spatie)">
            <Panel>
              <PathIcon Data="{StaticResource IconPlay}" Margin="3,0,0,0" IsVisible="{Binding !Player.IsPlaying}" />
              <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding Player.IsPlaying}" />
            </Panel>
          </Button>
          <Button Classes="icon" Command="{Binding Player.SkipForwardCommand}" ToolTip.Tip="10 seconden vooruit (→)">
            <PathIcon Data="{StaticResource IconForward}" />
          </Button>
          <Button Classes="icon" Command="{Binding NextCommand}" ToolTip.Tip="Volgende (N)">
            <PathIcon Data="{StaticResource IconNext}" />
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="1" Classes="title" Margin="18,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Text="{Binding CurrentTitle}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button x:Name="SpeedButton" Classes="icon text" Content="{Binding Player.RateText}" ToolTip.Tip="Afspeelsnelheid (+ / −)" />
          <Button x:Name="AudioButton" Classes="icon" ToolTip.Tip="Audiospoor">
            <PathIcon Data="{StaticResource IconAudioTrack}" />
          </Button>
          <Button x:Name="SubtitleButton" Classes="icon" ToolTip.Tip="Ondertitels">
            <PathIcon Data="{StaticResource IconSubtitles}" />
          </Button>
          <Button Classes="icon" Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="Dempen (M)">
            <Panel>
              <PathIcon Data="{StaticResource IconVolume}" IsVisible="{Binding !Player.ShowMutedIcon}" />
              <PathIcon Data="{StaticResource IconVolumeOff}" IsVisible="{Binding Player.ShowMutedIcon}" />
            </Panel>
          </Button>
          <Slider Classes="volume" Width="96" VerticalAlignment="Center"
                  Minimum="0" Maximum="100"
                  Value="{Binding Player.Volume}"
                  ToolTip.Tip="Volume (↑ / ↓)" />
          <Button x:Name="CastButton" Classes="icon" Classes.active="{Binding Cast.IsCasting}" ToolTip.Tip="Casten naar Chromecast">
            <PathIcon Data="{StaticResource IconCast}" />
          </Button>
          <Button Classes="icon" Command="{Binding ToggleEffectsCommand}" ToolTip.Tip="Aanpassingen: beeld, equalizer, synchronisatie">
            <PathIcon Data="{StaticResource IconTune}" />
          </Button>
          <Button x:Name="MoreButton" Classes="icon" ToolTip.Tip="Meer">
            <Panel>
              <PathIcon Data="{StaticResource IconMore}" />
              <Ellipse Width="8" Height="8" Fill="#FF3B30" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,6,6,0" IsVisible="{Binding Tools.IsRecording}" />
            </Panel>
          </Button>
          <Button Classes="icon" Command="{Binding TogglePlaylistCommand}" ToolTip.Tip="Afspeellijst">
            <PathIcon Data="{StaticResource IconPlaylist}" />
          </Button>
          <Button Classes="icon" Command="{Binding ToggleFullScreenCommand}" ToolTip.Tip="Volledig scherm (F)">
            <Panel>
              <PathIcon Data="{StaticResource IconFullScreen}" IsVisible="{Binding !IsFullScreen}" />
              <PathIcon Data="{StaticResource IconFullScreenExit}" IsVisible="{Binding IsFullScreen}" />
            </Panel>
          </Button>
        </StackPanel>

      </Grid>
    </StackPanel>
  </Border>

</UserControl>
