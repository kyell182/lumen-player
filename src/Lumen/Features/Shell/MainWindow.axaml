<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Lumen.Features.Shell"
        xmlns:shellViews="using:Lumen.Features.Shell.Views"
        xmlns:homeViews="using:Lumen.Features.Home.Views"
        xmlns:playbackViews="using:Lumen.Features.Playback.Views"
        xmlns:playlistViews="using:Lumen.Features.Playlist.Views"
        xmlns:updateViews="using:Lumen.Features.Updates.Views"
        xmlns:effectsViews="using:Lumen.Features.Effects.Views"
        xmlns:infoViews="using:Lumen.Features.MediaInfo.Views"
        x:Class="Lumen.Features.Shell.MainWindow"
        x:DataType="shell:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://Lumen/Assets/lumen.ico"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="520"
        Topmost="{Binding Tools.IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="44"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Titelbalk -->
    <Border x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent"
            IsVisible="{Binding !IsFullScreen}">
      <Grid x:Name="TitleBarContent" ColumnDefinitions="Auto,*,Auto" Margin="14,0,8,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource BrandGradientBrush}">
            <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" Foreground="White" Margin="1,0,0,0" />
          </Border>
          <TextBlock Text="Lumen" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" Margin="24,0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                   Text="{Binding CurrentTitle}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="icon small" Command="{Binding GoHomeCommand}"
                  IsVisible="{Binding !IsHomeVisible}" ToolTip.Tip="Startscherm">
            <PathIcon Data="{StaticResource IconHome}" />
          </Button>
          <Button x:Name="OpenButton" Classes="icon small" ToolTip.Tip="Openen: bestanden, map, netwerkstream, afspeellijst">
            <PathIcon Data="{StaticResource IconFolderOpen}" />
          </Button>
          <Button x:Name="AppearanceButton" Classes="icon small" ToolTip.Tip="Weergave: licht/donker en kleur">
            <PathIcon Data="{StaticResource IconTheme}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Updatemelding -->
    <Panel Grid.Row="1" IsVisible="{Binding !IsFullScreen}">
      <updateViews:UpdateBanner DataContext="{Binding Update}" />
    </Panel>

    <!-- Inhoud -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <Panel IsVisible="{Binding IsHomeVisible}">
        <homeViews:HomeView DataContext="{Binding Home}" />
      </Panel>
      <Panel x:Name="PlayerArea" IsVisible="{Binding !IsHomeVisible}"
             Background="{DynamicResource VideoBackgroundBrush}">
        <playbackViews:PlayerView x:Name="PlayerSurface" />
        <!-- De PlayerOverlay (bediening + ondertitels) komt hier of in een apart OverlayWindow: zie MainWindow.axaml.cs -->
      </Panel>
      <!-- Zijpanelen: er staat er hooguit één open -->
      <Panel Grid.Column="1" Width="340" IsVisible="{Binding IsPlaylistPanelVisible}">
        <playlistViews:PlaylistPanel DataContext="{Binding Playlist}" />
      </Panel>
      <Panel Grid.Column="1" Width="340" IsVisible="{Binding IsEffectsPanelVisible}">
        <effectsViews:EffectsPanel DataContext="{Binding Effects}" />
      </Panel>
      <Panel Grid.Column="1" Width="340" IsVisible="{Binding IsInfoPanelVisible}">
        <infoViews:MediaInfoPanel DataContext="{Binding MediaInfo}" />
      </Panel>
    </Grid>


  </Grid>
</Window>
