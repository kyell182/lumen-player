<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Vertelt Windows dat Lumen voor Windows 10/11 gemaakt is.
       Zonder dit kan Avalonia geen native kindvenster maken voor de video (NativeControlHost). -->
  <assemblyIdentity version="1.0.0.0" name="Lumen.Desktop" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 en 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
